# 복사해서 .env 로 쓰세요:  cp .env.example .env
# .env 는 Git 에 올리지 않습니다 (.gitignore).
POSTGRES_DB=gift_funding
POSTGRES_USER=gift_user
POSTGRES_PASSWORD=change-me-local-only
POSTGRES_PORT=5432

# 백엔드(FastAPI)가 쓸 접속 주소 (백엔드 단계에서 사용)
DATABASE_URL=postgresql://gift_user:change-me-local-only@localhost:5432/gift_funding

# 백엔드 로그인 토큰(JWT) 비밀키 — 길고 예측 불가능한 값으로 바꾸세요
#   만들기: openssl rand -hex 32
JWT_SECRET=change-me-run-openssl-rand-hex-32
# 정산 계좌번호 암호화 열쇠 (Fernet) — 한 번 정하면 바꾸지 마세요 (바꾸면 저장된 계좌번호를 못 읽음)
#   만들기: python3 -c "import base64,os;print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
ACCOUNT_ENCRYPTION_KEY=change-me-run-the-command-above
# AI 선물 추천 (GPT) — platform.openai.com 에서 발급 (유료, 월 사용 한도 설정 권장). 비워 두면 모의 추천
OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini
# (선택) Gemini — OPENAI_API_KEY 가 없을 때만 사용
GEMINI_API_KEY=
# 모델을 바꾸고 싶을 때만 (기본 gemini-3.8-flash)
# GEMINI_MODEL=gemini-3.8-flash
# 프론트 주소 (CORS 허용). 여러 개면 쉼표로
CORS_ORIGINS=http://localhost:3000
